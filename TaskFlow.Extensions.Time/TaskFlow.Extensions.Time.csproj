<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>$(DefineConstants);TASKFLOW_EXTENSIONS_TIME</DefineConstants>
    <RootNamespace>System.Threading.Tasks.Flow</RootNamespace>
    <PackageId>TaskFlow.Extensions.Time</PackageId>
    <Description>Leading-edge admission throttling for TaskFlow on netstandard2.0 with TimeProvider-based deterministic timing.</Description>
    <PackageTags>async;task-scheduler;task-queue;concurrency;throttling;time-provider;netstandard</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TaskFlow\Extensions\ThrottlingTaskSchedulerExtensions.cs" Link="ThrottlingTaskSchedulerExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskFlow\TaskFlow.csproj" />
  </ItemGroup>

  <Import Project="..\TaskFlow.Annotations\TaskFlow.Annotations.projitems" Label="Shared" />

</Project>
