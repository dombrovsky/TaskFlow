<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <TaskFlowAssemblyPath Condition="'$(TaskFlowAssemblyPath)' == ''">../../TaskFlow/bin/Release/net10.0/TaskFlow.dll</TaskFlowAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TaskFlow" HintPath="$(TaskFlowAssemblyPath)" />
  </ItemGroup>
</Project>