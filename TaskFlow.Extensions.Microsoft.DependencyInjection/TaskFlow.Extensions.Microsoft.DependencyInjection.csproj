<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<RootNamespace>System.Threading.Tasks.Flow</RootNamespace>
    <PackageId>TaskFlow.Microsoft.Extensions.DependencyInjection</PackageId>
		<Description>Microsoft dependency-injection integration for TaskFlow with scoped and named FIFO execution lanes and caller-owned factories.</Description>
		<PackageTags>async;task-scheduler;task-queue;concurrency;sequential;dependency-injection;microsoft-extensions</PackageTags>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	</ItemGroup>

  <ItemGroup>
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskFlow\TaskFlow.csproj" />
  </ItemGroup>

  <Import Project="..\TaskFlow.Annotations\TaskFlow.Annotations.projitems" Label="Shared" />

</Project>
