<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskFlow.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <TaskFlowSourceRoot Condition="'$(TaskFlowSourceRoot)' == ''">../..</TaskFlowSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TaskFlowSourceRoot)/TaskFlow/TaskFlow.csproj" />
  </ItemGroup>
</Project>
